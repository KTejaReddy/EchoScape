# ---------------------------------------------------------------------------
# EchoScape environment configuration
# Copy this file to backend/.env and fill in what you need.
# ---------------------------------------------------------------------------

# --- Groq Vision (room photo -> 3D layout) --------------------------------
# Required only for the AI room analysis step. Everything else works without it.
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# --- Audio -----------------------------------------------------------------
AUDIO_SAMPLE_RATE=48000
AUDIO_BLOCK_SIZE=2048
CARRIER_FREQUENCY=19000
AUDIO_AMPLITUDE=0.08
# Set to 1 to disable playing the probe tone (receive-only sensing).
AUDIO_GENERATE=1
# Optional: pick a specific input/output device by name (substring match).
AUDIO_DEVICE=
# Experimental: sweep the carrier frequency (Hz/s) instead of a fixed tone.
AUDIO_USE_CHIRP=0
AUDIO_CHIRP_RATE=400

# --- TDOA / spatial geometry ----------------------------------------------
MIC_DISTANCE=0.15
SPEED_OF_SOUND=343

# --- Motion detection ------------------------------------------------------
MOTION_THRESHOLD=0.35
TDOA_SMOOTHING=0.35
MOTION_SMOOTHING=0.4
POSITION_SMOOTHING=0.35
IDLE_HOLD_SECONDS=2.5
IDLE_CONFIDENCE_DECAY=0.5

# --- Demo mode -------------------------------------------------------------
DEMO_FRAME_RATE=15
DEMO_NOISE=0.04

# --- Server ----------------------------------------------------------------
ECHOSCAPE_HOST=127.0.0.1
ECHOSCAPE_PORT=5001
ECHOSCAPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ECHOSCAPE_LOG_LEVEL=INFO
